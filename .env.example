GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Opcional: token de acesso obtido pelos fluxos oficiais do Mercado Livre.
MELI_ACCESS_TOKEN=
# Opcional: conexão oficial para obter o token dentro do programa.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Preencha com o retorno HTTPS real aceito no portal, depois de publicado.
MELI_REDIRECT_URI=
# Opcional, se o Tesseract não estiver no PATH do Windows:
TESSERACT_CMD=
